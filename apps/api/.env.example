# Copie para .env e ajuste. A aplicação NÃO SOBE se faltar variável obrigatória.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://lanchonete:lanchonete@localhost:5432/lanchonete_dev
STORE_TIMEZONE=America/Sao_Paulo
JWT_SECRET=troque-este-segredo-em-producao
JWT_TTL=12h
# Origem do site (apps/web): libera o CORS e monta as back_urls do gateway.
# OBRIGATÓRIA — sem padrão. Em produção, a URL pública do site.
WEB_ORIGIN=http://localhost:3000
# URL pública DESTA API. Vira o notification_url da preferência do Mercado Pago,
# ou seja: é para cá que o webhook de pagamento é entregue. OBRIGATÓRIA.
# Em desenvolvimento, o túnel (ngrok) — localhost não recebe webhook.
# Em produção, o domínio do serviço da API no provedor.
API_PUBLIC_URL=http://localhost:3001
# Saltos de proxy confiáveis para descobrir o IP real do cliente (rate limiting).
# 0 em desenvolvimento (sem proxy). Em produção, o número que o provedor indicar.
TRUST_PROXY_HOPS=0
# Credenciais do Mercado Pago (decisão #15). Use as de teste (TEST-...) em dev.
MP_ACCESS_TOKEN=TEST-configure-sua-credencial
MP_WEBHOOK_SECRET=configure-o-segredo-do-webhook
