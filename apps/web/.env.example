# Copie para .env.local. OBRIGATÓRIA: sem ela o `next build` FALHA de propósito
# (antes havia um padrão silencioso de localhost:3001 — ver apps/web/src/lib/api.ts).
# Precisa do prefixo NEXT_PUBLIC_ para chegar ao navegador (o painel e o
# carrinho chamam a API direto do cliente). Consequência: o valor é gravado nos
# chunks durante o BUILD, não lido em runtime — no provedor de hospedagem ela
# precisa existir no momento de compilar, não só ao subir o processo.
NEXT_PUBLIC_API_URL=http://localhost:3001
